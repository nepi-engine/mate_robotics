[Unit]
Description=ROV camera 0 stream to topside and NEPI
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=rishipi5
SupplementaryGroups=video
WorkingDirectory=/home/rishipi5/rov-27
ExecStart=/home/rishipi5/rov-27/FastMJPG/bin/FastMJPG capture /dev/video0 640 480 1 30 send 192.168.68.22 5600 192.168.68.12 5600 1400 8000000 2 send 192.168.68.22 5614 192.168.68.103 5604 1400 8000000 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
