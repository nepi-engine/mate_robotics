<?xml version="1.0"?>
<package format="2">
  <name>nepi_app_auto_move</name>
  <version>0.0.0</version>
  <description>Click a point in an image to move the robot there</description>

  <maintainer email="nepi@numurus.com">numurus</maintainer>

  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>nepi_interfaces</build_depend>
  <build_depend>message_generation</build_depend>

  <build_export_depend>rospy</build_export_depend>
  <build_export_depend>std_msgs</build_export_depend>
  <build_export_depend>sensor_msgs</build_export_depend>
  <build_export_depend>geometry_msgs</build_export_depend>
  <build_export_depend>nav_msgs</build_export_depend>
  <build_export_depend>nepi_interfaces</build_export_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nepi_interfaces</exec_depend>
  <exec_depend>message_runtime</exec_depend>

  <!-- nepi_app_obstacles is NOT declared here. The obstacle overlay layer
       imports its Obstacles message behind a guarded import: where the package
       is installed the layer draws, where it is not the layer reports itself
       unavailable and goes inert. A hard dependency would make this app
       unbuildable on a device that does not carry the obstacles app. -->

  <export>
  </export>
</package>
